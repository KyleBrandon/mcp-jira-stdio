# Jira Authentication Configuration
# Copy this file to .env and fill in your actual values

# Your Jira instance URL (without trailing slash)
# Example: https://yourcompany.atlassian.net
JIRA_BASE_URL=https://yourcompany.atlassian.net

# Your Jira account email (required for Atlassian Cloud, omit for Data Center/Server)
# When set: uses Basic Auth (email:token). When omitted: uses Bearer token (PAT).
# Example: your.email@company.com
# JIRA_EMAIL=your.email@company.com

# Your Jira API token
# For Atlassian Cloud: Generate at https://id.atlassian.com/manage-profile/security/api-tokens
# For Data Center/Server: Use a Personal Access Token (PAT) from your Jira profile
JIRA_API_TOKEN=your_api_token_here

# Node environment (development/production)
# Set to 'development' to enable connection testing and debug messages
# Set to 'production' or leave empty for production mode (no connection test, minimal logging)
NODE_ENV=development

# Read-only mode (default: true)
# When true, write tools (create, update, delete, comment, transition) are hidden from the MCP tool list.
# Set to 'false' to enable write access to Jira.
JIRA_READ_ONLY=true

